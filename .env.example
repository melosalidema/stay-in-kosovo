# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-secret

# Database
DATABASE_URL=postgresql://stay:stay@localhost:5432/stay_in_kosovo?schema=public

# Social auth - optional in prototype
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maps - the app uses Leaflet + OpenStreetMap, no key required

# AI - the MVP uses deterministic simulated AI when this is empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External services
WEATHER_PROVIDER=open-meteo
