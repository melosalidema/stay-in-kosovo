# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-secret

# Database
# connection_limit tunes the Prisma connection pool (defaults to num_cpus*2+1).
# Use a lower value for serverless/containers and a higher value for long-running servers.
DATABASE_URL=postgresql://stay:stay@localhost:5432/stay_in_kosovo?schema=public&connection_limit=10

# Redis - optional, for distributed rate limiting and caching
REDIS_URL=

# Social auth - optional in prototype
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maps - the app uses Leaflet + OpenStreetMap, no key required
# GOOGLE_MAPS_API_KEY=

# AI - the MVP uses deterministic simulated AI when this is empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External services
WEATHER_PROVIDER=open-meteo

# Performance & caching (optional overrides)
PLACE_CACHE_TTL_MS=30000
PULSE_CACHE_TTL_MS=30000
WEATHER_TIMEOUT_MS=1500

# Auth rate limiting
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_MS=60000
